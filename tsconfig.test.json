// Type-checks the test files, and only them.
//
// The tests read the source tree from disk, so they need @types/node. Node's
// declarations are *global* — `process`, `Buffer`, `require` — and TypeScript
// scopes ambient globals to the whole program, not the file that pulled them
// in. Keeping the tests in the same program as the application would therefore
// make those globals visible to application code, which runs in a webview and
// has none of them: `process.env.FOO` would type-check and then be undefined
// at runtime.
//
// A triple-slash reference does not help — it widens the same program. Two
// programs is the only thing that actually separates them, which is why
// `pnpm lint` runs tsc twice.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true
  },
  // `exclude` is inherited through `extends`, and the base excludes exactly
  // these files. Clear it, or this program has no inputs at all.
  "exclude": [],
  // `vite-env.d.ts` is listed explicitly: `include` replaces (not merges
  // with) the base config's, so this program otherwise never picks up its
  // ambient declarations (`__APP_VERSION__`, `*.css`) — a test that reaches
  // them only via an app import (e.g. rendering a component that reads
  // `__APP_VERSION__`) would fail to type-check without it, even though
  // Vitest injects the real value at runtime regardless.
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/vite-env.d.ts"]
}
