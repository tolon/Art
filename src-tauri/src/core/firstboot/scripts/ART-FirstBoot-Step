.KEY name/A
.BRA [
.KET ]
; Runs one first-boot step and reports it. A step says no by setting the
; shell variable ART_StepRc to 20 (or any code of 5 and above) and skipping
; to its own end; it never Quits, because a Quit inside an Execute ends every
; script above it too (measured under WinUAE, 2026-09-07). A step that
; decides not to run writes its own "skipped <reason>" line first and ends
; normally. The key brackets are [] so that ${ART_StepRc} below is left to the shell.
FailAt 2000000000
Set ART_StepRc 0
Echo >>S:FirstBoot.log "step [name] started"
Execute S:FirstBoot/[name]
IF NOT ${ART_StepRc} EQ "0"
  Echo >>S:FirstBoot.log "step [name] refused rc=${ART_StepRc}"
ELSE
  Echo >>S:FirstBoot.log "step [name] ok"
  Delete >NIL: S:FirstBoot/[name]
ENDIF
; A step asks for a restart with SetEnv ART_Reboot "TRUE". The request is
; cleared first, because on 3.2 ENV: may be ENVARC: itself and a TRUE left
; behind would restart the next boot too. Wait 3 lets the filesystem finish
; its writes (measured 2026-09-15 on FFS: without it the volume needed
; validation 8 times in 8, with it 0 in 6). A release with no C:Reboot logs
; that it could not, and the run carries on to its end.
IF ${ART_Reboot} EQ "TRUE"
  SetEnv ART_Reboot "FALSE"
  Echo >>S:FirstBoot.log "reboot requested by [name]"
  IF EXISTS C:Reboot
    C:Wait 3
    C:Reboot
  ELSE
    Echo >>S:FirstBoot.log "reboot unavailable"
  ENDIF
ENDIF
