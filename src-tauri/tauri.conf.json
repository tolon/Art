{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amiga Retro Toolkit",
  "version": "0.1.0",
  "identifier": "com.amiga-retro-toolkit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Amiga Retro Toolkit",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": true,
        "center": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "tolon",
    "copyright": "Copyright (C) 2026 tolon",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "The Swiss Army Knife for Amiga Files",
    "longDescription": "Amiga Retro Toolkit (ART) is a professional Windows toolkit for Commodore Amiga users: ADF, HDF, LHA, ROM management, drag-and-drop analysis, and more.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {}
}
