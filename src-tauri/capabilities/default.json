{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "drag:default",
    "dialog:default",
    "fs:default",
    "log:default",
    "store:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-load",
    "sql:allow-close"
  ]
}
